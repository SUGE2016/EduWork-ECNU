{
  "name": "@chatecnu-work/dsh-external-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional external-agent trial using official DSH providers and lifecycle events",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./typert": "./lib/typert.js", "./package.json": "./package.json"},
  "files": ["lib", "cordis.patch.yml", "README.md", "README_EN.md"],
  "scripts": {"build": "node scripts/build.mjs", "test": "node --test test/*.test.mjs"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes"]}
  },
  "dependencies": {"@deepseek-ai/dsh-subagent-codex": "0.2.1-rc.3", "@deepseek-ai/dsh-subagent-acp": "0.2.1-rc.3"},
  "peerDependencies": {"@deepseek-ai/dsh-session": "0.2.1-rc.3", "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3", "@deepseek-ai/dsh-scope": "0.2.1-rc.3", "zod": "^4.0.0", "react": "^18.2.0", "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.3", "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3", "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"},
  "devDependencies": {"esbuild": "0.28.1"}
}
